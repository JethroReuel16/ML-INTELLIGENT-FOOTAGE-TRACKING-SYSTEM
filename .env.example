# docker-compose settings. Copy to .env and set a real password.
POSTGRES_DB=mlft
POSTGRES_USER=mlft
POSTGRES_PASSWORD=change-me-to-a-long-random-value

# Public URLs as seen by the browser.
PUBLIC_WEB_URL=http://localhost:3000
PUBLIC_API_URL=http://localhost:8000

# Set to true once the site is served over HTTPS.
COOKIE_SECURE=false
# COOKIE_DOMAIN=.example.org

# Host folder with video files that "local" sources may use.
FOOTAGE_DIR=./footage

# cpu | cuda (requires a CUDA build of the backend image and GPU access)
DETECTOR_DEVICE=cpu
