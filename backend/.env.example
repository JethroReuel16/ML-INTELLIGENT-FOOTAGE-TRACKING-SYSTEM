# ---------------------------------------------------------------------------
# ML Footage Tracking System — backend configuration
# Copy to backend/.env for local use; in production set real environment
# variables instead (they take precedence over this file).
# ---------------------------------------------------------------------------

# development | production. Production enables Secure cookies and hides /docs.
APP_ENV=development
LOG_LEVEL=INFO

# --- Database (PostgreSQL) -------------------------------------------------
# Either a full URL...
# DATABASE_URL=postgresql://mlft:change-me@db:5432/mlft
# ...or the individual parts:
DB_HOST=localhost
DB_PORT=5432
DB_NAME=mlft
DB_USER=mlft
DB_PASSWORD=change-me

# --- Browser access --------------------------------------------------------
# Comma-separated frontend origins allowed to call the API with cookies.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Session cookie. COOKIE_SECURE defaults to true when APP_ENV=production.
# COOKIE_SECURE=true
# COOKIE_SAMESITE=lax            # lax | strict | none (none requires HTTPS)
# COOKIE_DOMAIN=.example.org     # share the cookie between app. and api. subdomains
# SESSION_DAYS=7

# Self-service sign-up (default: on in development, OFF in production).
# With it off, create accounts with:  python manage.py create-user --email ... --name ...
# ALLOW_REGISTRATION=false

# Allow sources pointing at this machine (127.0.0.1). Default: off in production.
# ALLOW_LOOPBACK_SOURCES=false

# Load the ML models in the background at start-up so the first search does
# not wait (default: on in production).
# ML_PRELOAD=true

# Sign-in throttling (per client IP + email).
# LOGIN_MAX_ATTEMPTS=10
# LOGIN_WINDOW_SECONDS=900

# --- Storage ---------------------------------------------------------------
# Where uploads, results and debug crops are written. Use a persistent volume.
STORAGE_DIR=./storage
# MAX_VIDEO_UPLOAD_MB=2048
# MAX_IMAGE_UPLOAD_MB=20

# Folders "local" / "network" video sources may read (comma-separated).
# In production, file sources are DISABLED until this is set.
# ALLOWED_SOURCE_ROOTS=/srv/footage,/mnt/cctv

# --- ML engine (see ml-engene/ml_config.py for all options) ---------------
# ML_ENGINE_DIR=../ml-engene
DETECTOR_MODEL=yoloe
DETECTOR_DEVICE=cpu          # cpu | cuda | cuda:0 | mps
# Folder with yoloe-11s-seg.pt, yolo11n.pt and mobileclip_blt.ts. Unset = the
# directory uvicorn is started from. Pre-fetch with:
#   cd ../ml-engene && MODELS_DIR=... python -m tools.download_models
# MODELS_DIR=.
# YOLOE_CHECKPOINT=yoloe-11s-seg.pt
# DINO_MODEL=facebook/dinov2-base

# Interactive API docs at /docs (default: on in development, off in production).
# ENABLE_DOCS=false
