# Base URL of the ML Footage Tracking backend (FastAPI), without a trailing slash.
# This value is embedded in the browser bundle at BUILD time — rebuild after changing it.
#
# Session cookies are SameSite=Lax, so in production serve the frontend and the API
# from the same site (e.g. app.example.org and api.example.org, or one domain behind
# a reverse proxy) and list the frontend origin in the backend's CORS settings.
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
